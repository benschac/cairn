{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "access": { "type": "string", "enum": ["read", "comment", "edit", "manage"] },
    "createdAt": { "type": "string" },
    "createdBy": { "type": "string", "minLength": 1 },
    "current": {
      "type": "object",
      "properties": {
        "prd": { "type": "string", "pattern": "^rev_[a-z0-9]{12}$" },
        "spec": {
          "anyOf": [{ "type": "string", "pattern": "^rev_[a-z0-9]{12}$" }, { "type": "null" }]
        }
      },
      "required": ["prd", "spec"],
      "additionalProperties": true
    },
    "hasPlan": { "type": "boolean" },
    "id": { "type": "string", "pattern": "^doc_[a-z0-9]{12}$" },
    "markdown": { "type": "string" },
    "memberAccess": { "type": "string", "enum": ["none", "read", "comment", "edit"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "updatedAt": { "type": "string" },
    "visibility": { "type": "string", "enum": ["private", "public"] },
    "workspaceId": { "type": "string", "pattern": "^w_[a-z0-9]{12}$" }
  },
  "required": [
    "access",
    "createdAt",
    "createdBy",
    "current",
    "hasPlan",
    "id",
    "markdown",
    "memberAccess",
    "title",
    "updatedAt",
    "visibility",
    "workspaceId"
  ],
  "additionalProperties": true,
  "$defs": {}
}
