{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    { "$ref": "#/$defs/NotFoundEncoded" },
    { "$ref": "#/$defs/UnauthenticatedEncoded" },
    { "$ref": "#/$defs/ForbiddenEncoded" },
    { "$ref": "#/$defs/InvalidInputEncoded" },
    { "$ref": "#/$defs/ConflictEncoded" },
    { "$ref": "#/$defs/StaleRevisionEncoded" },
    { "$ref": "#/$defs/StaleCommentEncoded" },
    { "$ref": "#/$defs/LimitReachedEncoded" }
  ],
  "$defs": {
    "NotFoundEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["not-found"] },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "UnauthenticatedEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["unauthenticated"] },
        "message": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "ForbiddenEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["forbidden"] },
        "message": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "InvalidInputEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["invalid-input"] },
        "message": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "ConflictEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["conflict"] },
        "message": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "StaleRevisionEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["stale-revision"] },
        "message": { "type": "string" },
        "current": {
          "type": "object",
          "properties": {
            "author": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "principal": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": { "type": "string", "enum": ["user"] },
                        "userId": { "type": "string", "minLength": 1 }
                      },
                      "required": ["kind", "userId"],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "agentId": { "type": "string", "pattern": "^agt_[a-z0-9]{12}$" },
                        "for": { "type": "string", "minLength": 1 },
                        "kind": { "type": "string", "enum": ["agent"] }
                      },
                      "required": ["agentId", "for", "kind"],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": { "kind": { "type": "string", "enum": ["anonymous"] } },
                      "required": ["kind"],
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "required": ["name", "principal"],
              "additionalProperties": true
            },
            "at": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "documentId": { "type": "string", "pattern": "^doc_[a-z0-9]{12}$" },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "id": { "type": "string", "pattern": "^rev_[a-z0-9]{12}$" },
            "kind": { "type": "string", "enum": ["prd", "spec"] },
            "markdown": { "type": "string" },
            "number": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "parent": {
              "anyOf": [{ "type": "string", "pattern": "^rev_[a-z0-9]{12}$" }, { "type": "null" }]
            },
            "restoredFrom": {
              "anyOf": [{ "type": "string", "pattern": "^rev_[a-z0-9]{12}$" }, { "type": "null" }]
            }
          },
          "required": [
            "author",
            "at",
            "bytes",
            "documentId",
            "hash",
            "id",
            "kind",
            "markdown",
            "number",
            "parent",
            "restoredFrom"
          ],
          "additionalProperties": true
        }
      },
      "required": ["code", "message", "current"],
      "additionalProperties": true
    },
    "StaleCommentEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["stale-comment"] },
        "message": { "type": "string" },
        "current": {
          "type": "object",
          "properties": {
            "at": { "type": "string" },
            "author": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "principal": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": { "type": "string", "enum": ["user"] },
                        "userId": { "type": "string", "minLength": 1 }
                      },
                      "required": ["kind", "userId"],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "agentId": { "type": "string", "pattern": "^agt_[a-z0-9]{12}$" },
                        "for": { "type": "string", "minLength": 1 },
                        "kind": { "type": "string", "enum": ["agent"] }
                      },
                      "required": ["agentId", "for", "kind"],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": { "kind": { "type": "string", "enum": ["anonymous"] } },
                      "required": ["kind"],
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "required": ["name", "principal"],
              "additionalProperties": true
            },
            "body": { "type": "string", "maxLength": 20000 },
            "editedAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "id": { "type": "string", "pattern": "^n_[a-z0-9]{6,}$" },
            "thread": { "type": "string", "pattern": "^n_[a-z0-9]{6,}$" },
            "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          },
          "required": ["at", "author", "body", "editedAt", "id", "thread", "version"],
          "additionalProperties": true
        }
      },
      "required": ["code", "message", "current"],
      "additionalProperties": true
    },
    "LimitReachedEncoded": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["limit-reached"] },
        "message": { "type": "string" },
        "allowed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "dimension": {
          "type": "string",
          "enum": ["members", "prds", "privatePrds", "publicPrds", "guests"]
        },
        "plan": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "upgradeUrl": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "used": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      },
      "required": ["code", "message", "allowed", "dimension", "plan", "upgradeUrl", "used"],
      "additionalProperties": true
    }
  }
}
