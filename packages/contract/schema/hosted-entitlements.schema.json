{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "billing": { "type": "string", "enum": ["managed", "off"] },
    "graceEndsAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "limits": {
      "type": "object",
      "properties": {
        "guestsPerPrd": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "members": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "privatePrds": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "prds": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "publicPrds": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "required": ["guestsPerPrd", "members", "privatePrds", "prds", "publicPrds"],
      "additionalProperties": true
    },
    "overLimit": {
      "type": "array",
      "items": { "type": "string", "enum": ["members", "prds", "privatePrds", "publicPrds"] }
    },
    "plan": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "type": "string", "enum": ["free", "active", "past_due", "canceling", "canceled"] },
    "usage": {
      "type": "object",
      "properties": {
        "members": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "prds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "privatePrds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "publicPrds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["members", "prds", "privatePrds", "publicPrds"],
      "additionalProperties": true
    }
  },
  "required": ["billing", "graceEndsAt", "limits", "overLimit", "plan", "status", "usage"],
  "additionalProperties": true,
  "$defs": {}
}
