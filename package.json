{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "cairn": "node packages/cli/src/main.ts",
    "check": "node scripts/gate/gate.ts check",
    "check:commit": "turbo run typecheck typecheck:root lint format:check",
    "check:effect-api": "node scripts/effect-api/refresh-effect-api.ts --check && node scripts/effect-api/index-effect-core.ts --check",
    "check:tasks": "turbo run typecheck typecheck:root test test:guard test:gate test:demo-trace test:land test:tasks test:trailers test:lint check:effect-api check:xstate-docs lint format:check build",
    "check:xstate-docs": "node scripts/agent-sources/index-xstate-docs.ts --check",
    "demo-trace": "node scripts/demo-trace/demo-trace.ts",
    "dev": "turbo run dev",
    "fix": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "land": "node scripts/land/land.ts",
    "lint": "oxlint",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "tasks": "node scripts/tasks/tasks.ts",
    "test:gate": "node --test scripts/gate/gate.test.ts",
    "test:guard": "node --test scripts/guard/policy.test.ts",
    "test:demo-trace": "node --test scripts/demo-trace/plan.test.ts",
    "test:land": "node --test scripts/land/plan.test.ts",
    "test:lint": "node --test lint/effect-core-plugin.test.mjs",
    "test:tasks": "node --test scripts/tasks/report.test.ts scripts/tasks/reply-questions.test.ts",
    "test:trailers": "node --test scripts/trailers/commit-msg.test.ts",
    "typecheck:root": "effect-tsgo tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cairn/contract": "workspace:*",
    "@cairn/core": "workspace:*",
    "@effect/platform-node": "4.1.6",
    "@effect/tsgo": "0.73.2",
    "@types/node": "24.19.2",
    "effect": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.8"
}
