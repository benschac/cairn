{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "turbo run typecheck typecheck:root test test:guard lint format:check build",
    "fix": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test:guard": "node --test scripts/guard/policy.test.ts",
    "typecheck:root": "effect-tsgo tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.8"
}
