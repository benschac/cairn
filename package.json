{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "turbo run typecheck typecheck:root test test:guard test:land test:lint check:effect-api check:xstate-docs lint format:check build",
    "check:effect-api": "node scripts/effect-api/refresh-effect-api.ts --check && node scripts/effect-api/index-effect-core.ts --check",
    "check:xstate-docs": "node scripts/agent-sources/index-xstate-docs.ts --check",
    "dev": "turbo run dev",
    "fix": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "land": "node scripts/land/land.ts",
    "lint": "oxlint",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test:guard": "node --test scripts/guard/policy.test.ts",
    "test:land": "node --test scripts/land/plan.test.ts",
    "test:lint": "node --test lint/effect-core-plugin.test.mjs",
    "typecheck:root": "effect-tsgo tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/tsgo": "0.73.2",
    "@types/node": "24.19.2",
    "effect": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.8"
}
