{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    ".cairn/prd.md",
    ".cairn/spec.md",
    ".cairn/manifest.json",
    ".cairn/spec.json",
    "packages/cli/src/git.ts"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "packages/contract/src/**",
        "*.config.ts",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#test:guard": {
      "inputs": ["scripts/guard/**", "package.json"],
      "outputs": []
    },
    "//#test:gate": {
      "inputs": ["scripts/gate/**", "package.json"],
      "outputs": []
    },
    "//#test:land": {
      "inputs": ["scripts/land/**", "package.json"],
      "outputs": []
    },
    "//#test:tasks": {
      "inputs": ["scripts/tasks/**", "packages/contract/src/**", "package.json"],
      "outputs": []
    },
    "//#test:trailers": {
      "inputs": ["scripts/trailers/**", "packages/contract/src/**", "package.json"],
      "outputs": []
    },
    "//#test:lint": {
      "inputs": [
        "lint/**",
        "oxlint.config.ts",
        "tsconfig.json",
        "tsconfig.base.json",
        "packages/cli/tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#check:effect-api": {
      "inputs": [
        "scripts/effect-api/**",
        ".agent_sources/effect/index.md",
        ".agent_sources/effect/core-index.md",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "//#check:xstate-docs": {
      "inputs": [
        "scripts/agent-sources/**",
        ".agent_sources/xstate/**",
        ".agent_sources/xstate-effect/**",
        "packages/core/package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    }
  }
}
