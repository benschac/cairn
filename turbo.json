{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "*.config.ts",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#test:guard": {
      "inputs": ["scripts/guard/**", "package.json"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    }
  }
}
